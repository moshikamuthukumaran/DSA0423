import numpy as np

# Fuel efficiency of car models (mpg)
fuel_efficiency = np.array([25, 30, 28, 35, 40])

# Average fuel efficiency
avg_efficiency = np.mean(fuel_efficiency)

# Two car models for comparison
model_old = fuel_efficiency[0]
model_new = fuel_efficiency[4]

# Percentage improvement
percentage_improvement = ((model_new - model_old) / model_old) * 100

print("Average Fuel Efficiency:", avg_efficiency, "mpg")
print("Percentage Improvement:", percentage_improvement, "%")
